# Salin menjadi .env (lokal) — di Vercel, isi variabel yang sama di Project → Settings → Environment Variables.

# Database Supabase lewat "Transaction pooler" (IPv4). Supabase → Connect → Connection string → Transaction pooler.
# Jangan pakai host db.<ref>.supabase.co: hanya IPv6, tidak bisa dijangkau dari Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Auth (login) & Storage (berkas). Supabase → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
# RAHASIA — hanya untuk server. Jangan dipakai di kode frontend & jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Server lokal (opsional)
PORT=5211
# Cookie sesi bertanda Secure. Di Vercel otomatis true; isi false hanya untuk http lokal.
COOKIE_SECURE=false
